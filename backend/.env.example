# Copy to backend/.env for local overrides (never commit .env). Real environment variables
# take precedence over this file, and empty values count as unset. In dev every setting has a
# working default for scripts/dev_services.sh, so this file is only needed to change something.

# dev | test | prod. prod refuses to start unless the database and Redis URLs and the JWT keys
# are set explicitly and dev login is off.
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs are JSON in prod/test, readable console in dev.
APP_LOG_LEVEL=INFO

# PostgreSQL. postgres:// and postgresql:// URLs are accepted and use the asyncpg driver.
APP_DATABASE_URL=postgresql+asyncpg://quiz:quiz@127.0.0.1:54329/quiz_dev
# Connections per process: pool size plus overflow under load.
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=10

# Redis. In prod require a password (redis://:PASSWORD@redis:6379/0) or use rediss:// for TLS.
APP_REDIS_URL=redis://127.0.0.1:63790/0

# Access-token signing key: Ed25519 PEMs (newlines may be written as \n) and the key id put in
# the JWT header. Leave all three unset in dev/test to get an ephemeral pair per process.
# Generate a pair with:
#   openssl genpkey -algorithm ed25519 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# APP_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APP_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# APP_JWT_KEY_ID=2026-09-a

# AES-256 key (32 bytes, base64) that encrypts the refresh-token pair kept for 60 s so a client
# that crashed mid-refresh can retry. Required in prod and identical on every api replica;
# generated per process in dev/test. Generate with: openssl rand -base64 32
# APP_REFRESH_GRACE_KEY=

# Google OAuth *web* client id(s): the app's server client id, which Google puts in the ID
# token's audience (comma-separated). Without one, POST /v1/auth/google answers 503.
# APP_GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Enables POST /v1/auth/dev-login (password-less, by email) for local testing and protocol bots.
# Must be false in prod; when false the route does not exist.
APP_DEV_LOGIN_ENABLED=false

# Browser origins allowed by CORS (comma-separated). The mobile app needs none.
# APP_CORS_ORIGINS=http://localhost:8080
# Reverse proxies (IPs or CIDRs, comma-separated) whose X-Forwarded-For header is trusted when
# working out client IPs for rate limits. Empty: the TCP peer address is used as is.
# APP_TRUSTED_PROXIES=172.16.0.0/12

# Served by GET /v1/config. Clients with a build number below MIN_BUILD must update.
APP_MIN_BUILD=1
APP_MAINTENANCE=false
# Shown on the app's Maintenance screen (optional).
# APP_MAINTENANCE_MESSAGE=Back at 6 pm IST.

# When maintenance should end, and when planned maintenance starts (ISO 8601 with an offset).
# These and the maintenance and min-build settings can also be set in the app_config table,
# which wins, so they change without a redeploy.
# APP_MAINTENANCE_UNTIL=2026-10-01T18:00:00+05:30
# APP_MAINTENANCE_AT=2026-10-01T17:00:00+05:30

# Where suspended players can appeal (an email address or URL); shown on the Suspended screen.
APP_APPEAL_CONTACT=support@example.com

# Push notifications (Firebase Cloud Messaging HTTP v1). Path to a Google service-account JSON
# key allowed to send FCM messages; the project id is read from it unless set here. Without
# the key push is off: notifications still reach the inbox and the live channel.
# APP_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# APP_FCM_PROJECT_ID=quiz-arena-prod

# The question bank loaded by `python -m app.modules.content.seed` (relative to the working
# directory).
APP_CONTENT_DIR=../content

# The admin panel at /admin (SQLAdmin), served by the api process only when enabled. Admins are
# users with the admin role (grant it with scripts/create_admin.py) and sign in with Google.
APP_ADMIN_ENABLED=false
# Signs the admin session cookie; at least 32 characters, required in prod when enabled.
# Generate with: openssl rand -base64 48
# APP_ADMIN_SESSION_SECRET=
# How long an admin stays signed in, in seconds (default 8 hours).
# APP_ADMIN_SESSION_MAX_AGE_S=28800
# A Google OAuth *web* client for the panel (required in prod when enabled). Register
# <public url>/admin/auth/callback as its authorized redirect URI.
# APP_ADMIN_GOOGLE_CLIENT_ID=1234567890-admin.apps.googleusercontent.com
# APP_ADMIN_GOOGLE_CLIENT_SECRET=
# The redirect URI sent to Google; derived from the request when unset. Set it when a proxy
# changes the scheme or host (e.g. https://quiz.example.com/admin/auth/callback).
# APP_ADMIN_OAUTH_REDIRECT_URL=
# Only these client IPs or CIDRs may open the panel (comma-separated; client IPs honour
# APP_TRUSTED_PROXIES). Empty: any IP.
# APP_ADMIN_IP_ALLOWLIST=203.0.113.0/24,2001:db8::/32
# JSON object of feature flags.
APP_FEATURE_FLAGS={}

# Realtime (rt process). Defaults are the product rules; tests shorten them.
# This node's id in match leases and rt:conn (generated per process when unset).
# APP_RT_NODE_ID=rt-1
# APP_RT_TICKET_TTL_S=30
# Heartbeat interval (s) announced to clients, and the silence (s) that closes a socket, by
# state: idle, queued (or in a room) and in a match.
# APP_RT_HB_IDLE_S=30
# APP_RT_HB_QUEUE_S=10
# APP_RT_HB_MATCH_S=5
# APP_RT_STALE_IDLE_S=70
# APP_RT_STALE_QUEUE_S=25
# APP_RT_STALE_MATCH_S=12
# Match owner leases, their renewal, the failover scanner and when a match counts as overdue.
# APP_RT_LEASE_MS=4000
# APP_RT_LEASE_RENEW_S=1
# APP_RT_SCAN_INTERVAL_S=0.25
# APP_RT_OVERDUE_MS=1000
# Quick Battle and Practice Bot: questions, time per question, reveal, countdown, time to get
# ready, how early q.show is sent, the grace after the deadline, a disconnected player's grace,
# the extra grace when the server restarts, and the window in which both dropping voids a match.
# APP_MATCH_QUESTIONS=7
# APP_MATCH_LIMIT_MS=15000
# APP_MATCH_REVEAL_MS=3000
# APP_MATCH_COUNTDOWN_MS=3000
# APP_MATCH_READY_MS=10000
# APP_MATCH_SHOW_LEAD_MS=400
# APP_MATCH_ANSWER_GRACE_MS=250
# APP_MATCH_GRACE_MS=30000
# APP_MATCH_DRAIN_GRACE_MS=60000
# APP_MATCH_VOID_WINDOW_MS=5000
# Casual rematches (the window after match.end, how many in a row) and the casual entry fee.
# APP_MATCH_REMATCH_WINDOW_MS=15000
# APP_MATCH_REMATCH_MAX=3
# APP_CASUAL_FEE=5
# Scales the Practice Bot's answer times (its model's median is 6 s).
# APP_MATCH_BOT_TIME_SCALE=1.0
# Matchmaking: the bot/keep offer, the first-ever search's offer, keep searching, the longest
# search, offline and background limits, the leader tick, the abort cooldown and how many
# aborts in an hour start it, and rated games one pair may play in 24 h.
# APP_MM_TIMEOUT_S=45
# APP_MM_FIRST_TIMEOUT_S=20
# APP_MM_KEEP_S=60
# APP_MM_MAX_WAIT_S=105
# APP_MM_OFFLINE_S=10
# APP_MM_BACKGROUND_S=10
# APP_MM_TICK_S=0.5
# APP_MM_COOLDOWN_S=300
# APP_MM_ABORT_LIMIT=3
# APP_MM_RATED_PAIR_LIMIT=3
# The worker settles matches still waiting after this many seconds.
# APP_SETTLE_RETRY_AFTER_S=10

# Rooms (Play with Friend, Group Battle): idle lobby close, group host handover, a friend lobby
# closing when its host is away, the friend auto-start, rematch / "Play again" windows, the grace
# of a friend duel, how long a group game survives with fewer than 2 players, the group reveal,
# and invite expiry. APP_ROOM_TIME_SCALE scales the host's seconds per question (tests only).
# APP_ROOM_IDLE_MS=900000
# APP_ROOM_HANDOVER_MS=20000
# APP_ROOM_HOST_LEFT_MS=60000
# APP_ROOM_AUTOSTART_MS=3000
# APP_ROOM_REMATCH_MS=30000
# APP_ROOM_REMATCH_MAX=10
# APP_ROOM_AGAIN_MS=180000
# APP_ROOM_FRIEND_GRACE_MS=60000
# APP_ROOM_GROUP_SHORT_MS=30000
# APP_ROOM_GROUP_REVEAL_MS=4000
# APP_INVITE_TTL_S=120
# Room links are <APP_PUBLIC_URL>/j/<code>; the join page's Play Store button uses the package.
# APP_PUBLIC_URL=https://quiz.example.com
# APP_ANDROID_PACKAGE=com.mailcutzo.quiz_app
